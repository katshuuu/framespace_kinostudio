<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<GridPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.mirea.kinostudio.fx.controller.RequestDialogController"
          hgap="12" vgap="10" styleClass="form" prefWidth="560">
    <padding><Insets top="16" right="18" bottom="8" left="18"/></padding>
    <columnConstraints>
        <ColumnConstraints minWidth="110"/>
        <ColumnConstraints hgrow="ALWAYS"/>
    </columnConstraints>
    <Label text="Клиент *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <ComboBox fx:id="clientBox" promptText="Выберите клиента" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
    <Label text="Локация *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <ComboBox fx:id="locationBox" promptText="Выберите локацию" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    <Label text="Название *" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="titleField" promptText="Например: Съёмка рекламного ролика" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    <Label text="Описание *" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
    <TextArea fx:id="descriptionArea" prefRowCount="3" wrapText="true" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    <Label text="Дата съёмки *" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <DatePicker fx:id="datePicker" promptText="дд.мм.гггг" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    <Label text="Длительность, ч *" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
    <TextField fx:id="durationField" promptText="например 8" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    <Label text="Бюджет, ₽ *" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
    <TextField fx:id="budgetField" promptText="например 150000 или 150000.50" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
    <Label text="Статус" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
    <Label fx:id="statusInfo" styleClass="muted" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
    <Label fx:id="errorLabel" styleClass="error-box" wrapText="true" GridPane.rowIndex="8" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
</GridPane>
