<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<GridPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.mirea.kinostudio.fx.controller.ClientDialogController"
          hgap="12" vgap="10" styleClass="form" prefWidth="460">
    <padding><Insets top="16" right="18" bottom="8" left="18"/></padding>
    <columnConstraints>
        <ColumnConstraints minWidth="90"/>
        <ColumnConstraints hgrow="ALWAYS"/>
    </columnConstraints>
    <Label text="ФИО *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="nameField" promptText="Иванов Иван Иванович" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
    <Label text="Email *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="emailField" promptText="name@example.com" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    <Label text="Телефон *" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="phoneField" promptText="+7 900 111-22-33" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    <Label fx:id="errorLabel" styleClass="error-box" wrapText="true" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
</GridPane>
