<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.kinostudio.fx.controller.ClientsController" spacing="10" styleClass="tab-content">
    <padding><Insets top="14" right="16" bottom="12" left="16"/></padding>

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card">
        <TextField fx:id="searchField" HBox.hgrow="ALWAYS" promptText="Поиск по ФИО, email, телефону"/>
        <ComboBox fx:id="sortBox" prefWidth="220"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="＋ Добавить" onAction="#onAdd" styleClass="primary"/>
        <Button fx:id="editButton" text="Изменить" onAction="#onEdit"/>
        <Button fx:id="deleteButton" text="Удалить" onAction="#onDelete" styleClass="danger"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="muted"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="idCol" text="№" minWidth="45" maxWidth="60" styleClass="right"/>
            <TableColumn fx:id="nameCol" text="ФИО" minWidth="200"/>
            <TableColumn fx:id="emailCol" text="Email" minWidth="200"/>
            <TableColumn fx:id="phoneCol" text="Телефон" minWidth="140"/>
            <TableColumn fx:id="countCol" text="Заявок" minWidth="70" maxWidth="90"/>
        </columns>
    </TableView>

    <Label fx:id="relatedTitle" styleClass="section-caption"/>
    <TableView fx:id="relatedTable" prefHeight="170" minHeight="130">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="rTitleCol" text="Заявка" minWidth="220"/>
            <TableColumn fx:id="rDateCol" text="Дата съёмки" minWidth="100"/>
            <TableColumn fx:id="rStatusCol" text="Статус" minWidth="110"/>
            <TableColumn fx:id="rBudgetCol" text="Бюджет" minWidth="120"/>
        </columns>
    </TableView>
</VBox>
