<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<GridPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.mirea.kinostudio.fx.controller.LocationDialogController"
          hgap="12" vgap="10" styleClass="form" prefWidth="480">
    <padding><Insets top="16" right="18" bottom="8" left="18"/></padding>
    <columnConstraints>
        <ColumnConstraints minWidth="100"/>
        <ColumnConstraints hgrow="ALWAYS"/>
    </columnConstraints>
    <Label text="Название *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="nameField" promptText="Павильон №1" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
    <Label text="Тип *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <ComboBox fx:id="typeBox" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    <Label text="Адрес *" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="addressField" promptText="г. Москва, ул. Мосфильмовская, 1" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    <Label text="Вместимость *" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <TextField fx:id="capacityField" promptText="человек, например 300" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    <Label fx:id="errorLabel" styleClass="error-box" wrapText="true" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
</GridPane>
