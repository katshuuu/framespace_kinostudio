<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.kinostudio.fx.controller.LocationsController" spacing="10" styleClass="tab-content">
    <padding><Insets top="14" right="16" bottom="12" left="16"/></padding>

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card">
        <TextField fx:id="searchField" HBox.hgrow="ALWAYS" promptText="Поиск по названию и адресу"/>
        <Label text="Тип:"/>
        <ComboBox fx:id="typeFilter" promptText="Все типы" prefWidth="180"/>
        <ComboBox fx:id="sortBox" prefWidth="230"/>
        <Button text="Сбросить" onAction="#onReset" styleClass="ghost"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="＋ Добавить" onAction="#onAdd" styleClass="primary"/>
        <Button fx:id="editButton" text="Изменить" onAction="#onEdit"/>
        <Button fx:id="deleteButton" text="Удалить" onAction="#onDelete" styleClass="danger"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="muted"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="idCol" text="№" minWidth="45" maxWidth="60" styleClass="right"/>
            <TableColumn fx:id="nameCol" text="Название" minWidth="170"/>
            <TableColumn fx:id="typeCol" text="Тип" minWidth="130"/>
            <TableColumn fx:id="addressCol" text="Адрес" minWidth="230"/>
            <TableColumn fx:id="capacityCol" text="Вместимость" minWidth="95" maxWidth="120"/>
            <TableColumn fx:id="countCol" text="Заявок" minWidth="70" maxWidth="90"/>
        </columns>
    </TableView>

    <Label fx:id="relatedTitle" styleClass="section-caption"/>
    <TableView fx:id="relatedTable" prefHeight="170" minHeight="130">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="rTitleCol" text="Заявка" minWidth="220"/>
            <TableColumn fx:id="rClientCol" text="Клиент" minWidth="160"/>
            <TableColumn fx:id="rDateCol" text="Дата съёмки" minWidth="100"/>
            <TableColumn fx:id="rStatusCol" text="Статус" minWidth="110"/>
        </columns>
    </TableView>
</VBox>
