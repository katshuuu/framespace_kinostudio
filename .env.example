# Скопируйте в .env: cp .env.example .env
# Файл .env в git не попадает.
# Значения ниже подходят для локальной проверки КР №3 преподавателем.
# Перед публичным развёртыванием замените пароли и JWT-секрет на свои.

# --- PostgreSQL (Docker Compose backend) ---
POSTGRES_DB=framespace
POSTGRES_USER=framespace_app
POSTGRES_PASSWORD=framespace_demo
POSTGRES_PORT=55432

# --- JWT (Base64, не короче 32 байт исходных данных) ---
JWT_SECRET_BASE64=Zm9yLWxvY2FsLXRlc3RzLW9ubHktY2hhbmdlLW1lLTEyMzQ1Njc4OTA=
JWT_ISSUER=framespace
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# --- Bootstrap-администратор (после первого входа система попросит сменить пароль) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_PASSWORD=DemoPassw0rd!x

# --- Безопасность / CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:8080
COOKIE_SECURE=false
PERMANENT_DELETE_ENABLED=false

# --- Порты ---
APP_PORT=8080
