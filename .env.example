# Скопируйте в .env: cp .env.example .env
# Файл .env в git не попадает. Укажите свои секреты перед запуском.

# --- PostgreSQL (Docker Compose backend) ---
POSTGRES_DB=framespace
POSTGRES_USER=framespace_app
POSTGRES_PASSWORD=замените_на_свой_пароль_бд
POSTGRES_PORT=55432

# --- JWT ---
JWT_SECRET_BASE64=замените_на_случайный_base64_секрет_длиной_не_менее_32_байт
JWT_ISSUER=framespace
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# --- Bootstrap-администратор (временный пароль, сменить после первого входа) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_PASSWORD=замените_на_временный_пароль_администратора

# --- Безопасность / CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:8080
COOKIE_SECURE=false
PERMANENT_DELETE_ENABLED=false

# --- Порты ---
APP_PORT=8080
