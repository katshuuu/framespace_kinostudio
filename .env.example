# Скопируйте этот файл в .env и впишите свои значения: cp .env.example .env
# Файл .env в git не попадает (см. .gitignore).

# --- База данных PostgreSQL ---
# Запуск приложения на компьютере + база в Docker: порт DB_PUBLISHED_PORT (по умолчанию 5433).
# Если используете свою установленную PostgreSQL — поставьте 5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=kinostudio_db
DB_USER=postgres
DB_PASSWORD=postgres

# --- Единый администратор информационной системы ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin12345

# --- Docker: порт, на котором открывается окно приложения в браузере ---
NOVNC_PORT=6080
# Порт PostgreSQL на вашем компьютере (чтобы не конфликтовал с установленным)
DB_PUBLISHED_PORT=5433
